# Environment Variables for AuraStore Spring Boot Backend Deployment on Render

# Port assigned dynamically by Render (defaults to 8081 locally)
PORT=8081

# MongoDB Connection String (e.g. MongoDB Atlas cluster URL)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aurastore_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/aurastore12_db

# Base64 encoded secret for JWT token generation
JWT_SECRET=dGhpc0lzQVN1cGVyU2VjdXJlSldUU2VjcmV0S2V5Rm9yQXVyYVN0b3JlMjAyNg==

# JWT Expiration in milliseconds (Default: 604800000 = 7 days)
JWT_EXPIRATION_MS=604800000

# Allowed CORS origins (e.g. your deployed frontend URL on Vercel/Render/Netlify, or * for all)
CLIENT_URL=http://localhost:3000,http://localhost:5173
